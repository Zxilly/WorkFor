{
  "manifestVersion": 1,
  "apiVersion": 1,
  "id": "builtin.monthly",
  "name": "按月薪分摊",
  "version": "1.0.0",
  "entry": "index.mjs",
  "parametersSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["monthlySalary"],
    "properties": {
      "monthlySalary": {
        "type": "string",
        "title": "月薪",
        "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,2})?$",
        "default": "16000.00"
      }
    }
  }
}
